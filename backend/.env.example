# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3001
LAB_MODE=true
LOG_LEVEL=info

# Database & Cache Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whalepath_paper
REDIS_URL=redis://localhost:6379
REDIS_USE_IN_MEMORY_FALLBACK=true

# Third-Party Provider Base URLs & API Keys
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so
BIRDEYE_API_KEY=0e08e9213791433f89454816a934b3e1
GOPLUS_BASE_URL=https://api.gopluslabs.io
GOPLUS_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Rate Limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
DEXSCREENER_RATE_LIMIT_RPS=30
BIRDEYE_RATE_LIMIT_RPS=1
GOPLUS_RATE_LIMIT_RPS=30
COINGECKO_RATE_LIMIT_RPM=10

# Retries & Resilience
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=10000
CIRCUIT_BREAKER_TIMEOUT_MS=5000
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
CIRCUIT_BREAKER_ERROR_THRESHOLD_PERCENTAGE=50

# Cache TTLs (in seconds)
CACHE_TTL_DEFAULT_SECONDS=300
CACHE_TTL_TOKEN_METRICS_SECONDS=60
CACHE_TTL_PRICE_SECONDS=15
CACHE_TTL_SECURITY_INFO_SECONDS=3600

# Pair Selection & Deviation Minimums
DEX_MIN_LIQUIDITY_USD=10000
DEX_MIN_VOLUME_24H_USD=10000
PRICE_DEVIATION_THRESHOLD_PERCENT=1.0

# Auth & Security
API_SECRET_KEY=whales_paper_trading_secret_key_minimum_32_characters
